{

  "description": "Helper for browser translate feature",
  "manifest_version": 3,
  "name": "Translate",
  "version": "1.0",
  "homepage_url": "https://github.com/joelhorrocks/paperclip",

  "browser_specific_settings": {
    "gecko": {
      "id": "translate@joelhorrocks.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content_script.js"]
    }
  ],
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ]
}